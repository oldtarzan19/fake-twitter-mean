pipeline {
  agent any

  options {
    timestamps()
    //ansiColor('xterm')
    disableConcurrentBuilds()
  }

  environment {
    DOCKER_BUILDKIT = "1"
    COMPOSE_FILE = "compose.devops.yml"
  }

  tools {
    nodejs "node20"
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.SHORT_SHA = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
        }
      }
    }

    stage('Frontend CI') {
      steps {
        dir('frontend') {
          sh """
            npm install
            npm run lint --if-present
            npm run build
          """
        }
      }
    }

    stage('Backend CI') {
      steps {
        dir('backend') {
          sh """
            npm install
            npm run build
          """
        }
      }
    }

    stage('Docker Build') {
      steps {
        sh """
          docker compose -f ${COMPOSE_FILE} build --no-cache grafana
          docker compose -f ${COMPOSE_FILE} build frontend backend nginx-gateway prometheus
        """
      }
    }

    stage('Compose Deploy') {
      steps {
        sh """
          cp -n .env.devops.example .env.devops || true
          docker compose -f ${COMPOSE_FILE} pull || true
          # Only restart the services we built
          docker compose -f ${COMPOSE_FILE} up -d --no-deps frontend backend nginx-gateway prometheus grafana
        """
      }
    }

    stage('Post Checks') {
      steps {
        sh '''
          set -euxo pipefail

          # Backend health (direct access via Docker network)
          curl -sf http://backend:3000/api/health || echo "Backend health check failed"

          # Nginx gateway (internal network)
          curl -sf http://nginx-gateway/api/health || echo "Nginx health check failed"

          # Prometheus health
          curl -sf http://prometheus:9090/-/healthy || echo "Prometheus health check failed"

          # Prometheus targets check
          curl -s http://prometheus:9090/api/v1/targets | jq -r '.data.activeTargets | length' || echo "0"

          # Grafana health
          curl -sf http://grafana:3000/api/health || echo "Grafana health check failed"

          # Graylog syslog test
          echo "<14>1 $(date -u +"%Y-%m-%dT%H:%M:%S.000Z") fake-jenkins cicd - - - Jenkins syslog probe" | nc -u -w1 graylog 5140 || echo "Graylog syslog test failed"
        '''
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'frontend/dist/**/*, backend/dist/**/*', allowEmptyArchive: true
    }
  }
}
